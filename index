<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Parque Nelson Mandela</title>

  <script src="https://aframe.io/releases/1.7.0/aframe.min.js"></script>
</head>

<body>

  <a-scene>

    <!-- Modelo 3D -->
    <a-entity
      gltf-model="url(parque.glb)"
      position="0 0 0"
      rotation="0 0 0"
      scale="1 1 1">
    </a-entity>

    <!-- Cámara -->
    <a-entity
      camera
      look-controls
      wasd-controls
      position="0 1.6 5">
    </a-entity>

  </a-scene>

</body>
</html>
